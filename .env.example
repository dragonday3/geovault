# Copy to .env and replace every value. .env is gitignored — never commit it.
# Generate strong values, e.g.:  py -3.10 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-superuser-password
GEOVAULT_DB_PASSWORD=change-me-app-password
# JWT signing key: 32+ random characters. The API refuses to start with a weak value.
# Generate:  py -3.10 -c "import secrets; print(secrets.token_urlsafe(48))"
GEOVAULT_JWT_SECRET=replace-with-48-random-url-safe-characters

# Host port for the API/UI (bound to 127.0.0.1 only). Change if 8000 is taken.
GEOVAULT_API_PORT=8000

# GeoServer (milestone 12, opt-in profile). The admin password is mandatory: without it the
# image would fall back to the well-known admin/geoserver.
GEOSERVER_ADMIN_USER=gvadmin
GEOSERVER_ADMIN_PASSWORD=replace-with-a-long-random-value
# Read-only DB role GeoServer uses (can only SELECT the public_places view).
GEOVAULT_GEOSERVER_DB_PASSWORD=replace-with-a-long-random-value
GEOVAULT_GEOSERVER_PORT=8080
